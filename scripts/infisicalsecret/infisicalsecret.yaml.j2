apiVersion: secrets.infisical.com/v1alpha1
kind: InfisicalSecret
metadata:
  name: {{ app }}
spec:
  hostAPI: http://infisical-infisical-standalone-infisical.infisical.svc.cluster.local:8080/api
  syncConfig:
    resyncInterval: {{ resync }}
  authentication:
    kubernetesAuth:
      identityId: {{ stack_info.identity_id }}
      autoCreateServiceAccountToken: true
      serviceAccountRef:
        name: {{ stack_info.service_account }}
        namespace: infisical-operator
      secretsScope:
        projectSlug: {{ stack }}
        envSlug: {{ env_slug }}
        secretsPath: {{ final_path }}
        recursive: false
  managedKubeSecretReferences:
    - secretName: {{ final_secret_name }}
      secretNamespace: {% raw %}{{ .Release.Namespace }}{% endraw %}

      creationPolicy: Owner
